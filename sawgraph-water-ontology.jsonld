  "@graph": [
    {
      "@id": "hyfo:SurfaceWaterFeature",
      "@type": "owl:Class",
      "dcterms:description": "A complete surface water feature including water, container, and void (for example: lake, river, marsh, et al.)",
      "rdfs:label": "hyfo:SurfaceWaterFeature",
      "rdfs:subClassOf": {
        "@id": "hyfo:WaterFeature"
      }
    },
    {
      "@id": "dcterms:issued",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "geo:defaultGeometry",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "The default Geometry to be used in spatial calculations. It is usually the most detailed Geometry.",
      "rdfs:domain": {
        "@id": "geo:Feature"
      },
      "rdfs:isDefinedBy": [
        {
          "@id": "geo:"
        },
        {
          "@id": "http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties"
        }
      ],
      "rdfs:label": "geo:defaultGeometry",
      "rdfs:range": {
        "@id": "geo:Geometry"
      },
      "rdfs:subPropertyOf": {
        "@id": "geo:hasGeometry"
      }
    },
    {
      "@id": "gwml2:GW_HydrogeoUnit",
      "@type": "owl:Class",
      "dcterms:description": "Any soil or rock unit or zone that by virtue of its hydraulic properties has a distinct influence on the storage or movement of groundwater (after ANS, 1980)",
      "rdfs:isDefinedBy": {
        "@id": "https://docs.ogc.org/is/19-013/19-013.html"
      },
      "rdfs:label": "gwml2:GW_HydrogeoUnit"
    },
    {
      "@id": "gwml2:gwWellUnit",
      "@type": "owl:ObjectProperty",
      "dcterms:description": "Identifies the aquifers or confining beds intersecting the well",
      "owl:equivalentProperty": {
        "@id": "hyfo:tapsAquifer"
      },
      "rdfs:domain": {
        "@id": "gwml2:GW_Well"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://docs.ogc.org/is/19-013/19-013.html"
      },
      "rdfs:label": "gwml2:gwWellUnit",
      "rdfs:range": {
        "@id": "gwml2:GW_AquiferUnit"
      }
    },
    {
      "@id": "dcterms:modified",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "geo:hasGeometry",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "A spatial representation for a given Feature.",
      "rdfs:domain": {
        "@id": "geo:Feature"
      },
      "rdfs:isDefinedBy": [
        {
          "@id": "geo:"
        },
        {
          "@id": "http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/feature-properties"
        },
        {
          "@id": "http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties"
        }
      ],
      "rdfs:label": "geo:hasGeometry",
      "rdfs:range": {
        "@id": "geo:Geometry"
      }
    },
    {
      "@id": "geo:Feature",
      "@type": "owl:Class",
      "owl:disjointWith": {
        "@id": "geo:Geometry"
      },
      "rdfs:comment": "A discrete spatial phenomenon in a universe of discourse.",
      "rdfs:isDefinedBy": [
        {
          "@id": "geo:"
        },
        {
          "@id": "http://www.opengis.net/spec/geosparql/1.0/req/core/feature-class"
        },
        {
          "@id": "http://www.opengis.net/spec/geosparql/1.1/req/core/feature-class"
        }
      ],
      "rdfs:label": "geo:Feature",
      "rdfs:subClassOf": {
        "@id": "geo:SpatialObject"
      }
    },
    {
      "@id": "hyf:HY_Catchment",
      "@type": "owl:Class",
      "dcterms:description": "captures the union of catchment and hydro nexus, and the multiple realizations of the holistic catchment concept",
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
        },
        {
          "@id": "https://github.com/opengeospatial/HY_Features/tree/master/ontology"
        }
      ],
      "rdfs:label": "hyf:HY_Catchment",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_HydroFeature"
      }
    },
    {
      "@id": "nhdplusv2:partOfMainStem",
      "@type": "owl:ObjectProperty",
      "dcterms:description": "Connects an elementary flowpath (e.g., NHDFlowline) to its main stem",
      "rdfs:domain": {
        "@id": "nhdplusv2:FlowLine"
      },
      "rdfs:label": "nhdplusv2:partOfMainStem",
      "rdfs:range": {
        "@id": "nhdplusv2:MainStem"
      },
      "rdfs:subPropertyOf": {
        "@id": "nhdplusv2:partOfFlowPath"
      }
    },
    {
      "@id": "_:n33de5ffb7d9f4af3a3bc6e0eadb1b61fb24",
      "@type": "owl:AllDisjointClasses",
      "owl:members": {
        "@list": [
          {
            "@id": "hyfo:SubsurfaceWaterFeature"
          },
          {
            "@id": "hyfo:SurfaceWaterFeature"
          }
        ]
      }
    },
    {
      "@id": "dcterms:title",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "hyf:HY_Impoundment",
      "@type": "owl:Class",
      "dcterms:description": "a body of surface water, participating in a hydrographic network, seen as being special due to being formed by collecting water, for example in the case of a dam",
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
        },
        {
          "@id": "https://github.com/opengeospatial/HY_Features/tree/master/ontology"
        }
      ],
      "rdfs:label": "hyf:HY_Impoundment",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_WaterBody"
      }
    },
    {
      "@id": "hyf:HY_CatchmentArea",
      "@type": "owl:Class",
      "dcterms:description": "Two-dimensional (areal) hydrology-specific realization of the holistic catchment",
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
        },
        {
          "@id": "https://github.com/opengeospatial/HY_Features/tree/master/ontology"
        }
      ],
      "rdfs:label": "hyf:HY_CatchmentArea",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_CatchmentRealization"
      }
    },
    {
      "@id": "hyfo:WaterFeatureRepresentation",
      "@type": "owl:Class",
      "dcterms:description": "A representation of a water feature (for example, a line or polygon)",
      "rdfs:label": "hyfo:WaterFeatureRepresentation",
      "rdfs:subClassOf": {
        "@id": "geo:Geometry"
      }
    },
    {
      "@id": "hyf:HY_FlowPath",
      "@type": "owl:Class",
      "dcterms:description": "realizes a catchment specifically as a path connecting the inflow and outflow of the catchment it realizes",
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
        },
        {
          "@id": "https://github.com/opengeospatial/HY_Features/tree/master/ontology"
        }
      ],
      "rdfs:label": "hyf:HY_FlowPath",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_CatchmentRealization"
      }
    },
    {
      "@id": "hyf:HY_Lake",
      "@type": "owl:Class",
      "dcterms:description": "a body of surface water, participating in a hydrographic network, made special due to its considerable size",
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
        },
        {
          "@id": "https://github.com/opengeospatial/HY_Features/tree/master/ontology"
        }
      ],
      "rdfs:label": "hyf:HY_Lake",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_WaterBody"
      }
    },
    {
      "@id": "http://purl.org/spatialai/spatial/water-full",
      "@type": "owl:Ontology",
      "dc:source": {
        "@id": "https://raw.githubusercontent.com/SAWGraph/water-kg/refs/heads/main/ontologies/sawgraph-water-ontology.ttl"
      },
