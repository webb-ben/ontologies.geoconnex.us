      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2024-09-04"
      },
      "dcterms:creator": {
        "@id": "https://orcid.org/0000-0002-9070-3169"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "This ontology supports querying the SAWGraph Knowledge Graph. It adapts and extends concepts from HY_Features, HyFO, and GWML2"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2025-04-21"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2025-08-01"
      },
      "dcterms:publisher": {
        "@id": "https://sawgraph.github.io/"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "SAWGraph's hydrology (water) ontology - an adaptation and extension of concepts from HY_Features, HyFO, and GWML2"
      },
      "owl:versionInfo": {
        "@language": "en",
        "@value": "1.0"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "SAWGraph's hydrology (water) ontology - an adaptation and extension of concepts from HY_Features, HyFO, and GWML2"
      }
