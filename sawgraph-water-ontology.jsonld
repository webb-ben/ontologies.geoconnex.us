    {
      "@id": "hyfo:WaterWell",
      "@type": "owl:Class",
      "dcterms:description": "A water well, with focus on the hole/shaft itself (see gwml2:GW_Well)",
      "owl:equivalentClass": {
        "@id": "gwml2:GW_Well"
      },
