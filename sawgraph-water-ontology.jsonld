    },
    {
      "@id": "gwml2:GW_Well",
      "@type": "owl:Class",
      "dcterms:description": "A shaft or hole sunk, dug or drilled into the Earth to observe, extract or inject water (after IGH1397)",
      "owl:equivalentClass": {
        "@id": "hyfo:WaterWell"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://docs.ogc.org/is/19-013/19-013.html"
      },
      "rdfs:label": "gwml2:GW_Well",
      "rdfs:subClassOf": {
        "@id": "hyfo:SubsurfaceWaterFeature"
      }
    },
    {
      "@id": "hyf:downstreamWaterBody",
      "@type": "owl:ObjectProperty",
      "dcterms:description": "Identifies another waterbody immediately downstream, allowing network navigation without knowing an inflow or outflow of the catchment realized by the waterbody",
      "owl:inverseOf": {
        "@id": "hyf:upstreamWaterBody"
      },
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
