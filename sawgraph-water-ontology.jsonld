    {
      "@id": "dcterms:publisher",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "hyf:HY_Lagoon",
      "@type": "owl:Class",
      "dcterms:description": "a body of surface water, participating in a hydrographic network, which is special due to its shallow depth and interaction with the open sea",
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
        },
        {
          "@id": "https://github.com/opengeospatial/HY_Features/tree/master/ontology"
        }
      ],
      "rdfs:label": "hyf:HY_Lagoon",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_WaterBody"
      }
    },
    {
      "@id": "skos:prefLabel",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "nhdplusv2:downstreamFlowPathTC",
      "@type": [
        "owl:ObjectProperty",
        "owl:TransitiveProperty"
      ],
      "dcterms:description": "The transitive closure of the nhdplusv2:downstreamFlowPath object property",
      "rdfs:domain": {
        "@id": "nhdplusv2:FlowPath"
      },
      "rdfs:label": "nhdplusv2:downstreamFlowPathTC",
      "rdfs:range": {
