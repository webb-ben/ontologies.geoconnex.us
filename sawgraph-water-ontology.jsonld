          }
        ]
      }
    },
    {
      "@id": "nhdplusv2:associatedCatchmentArea",
      "@type": "owl:ObjectProperty",
      "dcterms:description": "Identifies the one and only one catchment area that is associated with a particular flowpath",
      "rdfs:domain": {
        "@id": "nhdplusv2:FlowPath"
      },
      "rdfs:label": "nhdplusv2:associatedCatchmentArea",
      "rdfs:range": {
        "@id": "hyf:HY_CatchmentArea"
      }
    },
    {
      "@id": "hyf:realizedCatchment",
      "@type": "owl:ObjectProperty",
      "dcterms:description": "Identifies the one and only one catchment that is realized by a particular feature",
      "rdfs:domain": {
        "@id": "hyf:HY_CatchmentRealization"
      },
      "rdfs:isDefinedBy": [
        {
          "@id": "https://docs.ogc.org/is/14-111r6/14-111r6.html"
        },
        {
          "@id": "https://github.com/opengeospatial/HY_Features/tree/master/ontology"
        }
      ],
      "rdfs:label": "hyf:realizedCatchment",
      "rdfs:range": {
        "@id": "hyf:HY_Catchment"
      }
    },
    {
      "@id": "nhdplusv2:downstreamFlowPath",
      "@type": "owl:ObjectProperty",
      "dcterms:description": "Identifies another flowpath immediately downstream, allowing network navigation without knowing an inflow or outflow of the catchment realized by the flowpath",
      "owl:inverseOf": {
        "@id": "nhdplusv2:upstreamFlowPath"
      },
      "rdfs:label": "nhdplusv2:downstreamFlowPath",
      "rdfs:subPropertyOf": [
        {
          "@id": "nhdplusv2:downstreamFlowPathTC"
        },
        {
          "@id": "hyf:downstreamWaterBody"
        }
      ]
    },
    {
      "@id": "gwml2:gwAquiferSystem",
      "@type": "owl:ObjectProperty",
      "dcterms:description": "Relates an aquifer system part, which can be another system, aquifer or confining bed, with its aquifer system",
      "rdfs:domain": {
        "@id": "gwml2:GW_Aquifer"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://docs.ogc.org/is/19-013/19-013.html"
      },
      "rdfs:label": "gwml2:gwAquiferSystem",
      "rdfs:range": {
        "@id": "gwml2:GW_AquiferSystem"
      }
    },
    {
      "@id": "gwml2:GW_AquiferUnit",
      "@type": "owl:Class",
      "dcterms:description": "Denotes aquifer-related hydrogeological units: aquifer systems, aquifers, or confining beds",
      "rdfs:isDefinedBy": {
        "@id": "https://docs.ogc.org/is/19-013/19-013.html"
      },
      "rdfs:label": "gwml2:GW_AquiferUnit",
      "rdfs:subClassOf": [
        {
          "@id": "gwml2:GW_HydrogeoUnit"
        },
