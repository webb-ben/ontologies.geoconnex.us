      "@id": "_:n33de5ffb7d9f4af3a3bc6e0eadb1b61fb7",
      "@type": "owl:Restriction",
      "owl:maxQualifiedCardinality": {
        "@type": "xsd:nonNegativeInteger",
        "@value": "1"
      },
      "owl:onClass": {
        "@id": "nhdplusv2:MainStem"
      },
      "owl:onProperty": {
        "@id": "nhdplusv2:partOfFlowPath"
      }
