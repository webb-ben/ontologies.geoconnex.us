        "@id": "http://qudt.org/2.1/schema/qudt"
      },
      "rdfs:label": "qudt:Quantity"
    },
    {
      "@id": "nhdplusv2:FlowLine",
      "@type": "owl:Class",
      "dcterms:description": [
        "any atomic/elementary kind of HY_FlowPath within a given framework/context (for example, a single NHDFlowline instance)",
        "area of associated catchment may be zero (per hydrologic fabric logic model)",
        "can be part of at most one mainstem"
      ],
      "rdfs:label": "nhdplusv2:FlowLine",
      "rdfs:subClassOf": [
        {
          "@id": "nhdplusv2:FlowPath"
        },
        {
          "@id": "_:n33de5ffb7d9f4af3a3bc6e0eadb1b61fb7"
        }
      ]
    },
