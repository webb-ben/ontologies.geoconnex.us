    },
    {
      "@id": "schema:temporalCoverage",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Schema.org temporalCoverage accepts flexible text, dates, and intervals. If the data can be normalized, also add dcterms:temporal with a typed PeriodOfTime node."
      }
    },
    {
      "@id": "hyf:HY_HydroFeature",
      "rdfs:subClassOf": {
