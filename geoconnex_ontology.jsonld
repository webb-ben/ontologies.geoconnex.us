    {
      "@id": "schema:coordinates",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Prefer geo:asWKT or schema:latitude/schema:longitude where possible. schema:coordinates is useful as a lightweight fallback."
      }
    },
    {
      "@id": "http://schema.org/Person",
      "owl:equivalentClass": {
        "@id": "schema:Person"
      },
      "skos:editorialNote": {
