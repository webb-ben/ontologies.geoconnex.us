      "rdfs:range": {
        "@id": "_:n3ca73efd176d4b82873374fc5ab256b9b4"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Use schema:geo directly for Schema.org-facing coordinate or shape summaries. Use geo:hasGeometry or geo:defaultGeometry for formal GeoSPARQL geometries."
      }
    },
    {
      "@id": "_:n3ca73efd176d4b82873374fc5ab256b9b4",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "schema:GeoCoordinates"
