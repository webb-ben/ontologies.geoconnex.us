    },
    {
      "@id": "rdf:type",
      "skos:editorialNote": {
        "@language": "en",
        "@value": "RDF's built-in type predicate. It is intentionally not redeclared as a Geoconnex object or datatype property; use it directly for class membership."
      }
    },
    {
      "@id": "rdfs:Datatype",
      "@type": "owl:Class",
