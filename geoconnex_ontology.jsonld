      }
    },
    {
      "@id": "hyf:HY_IndirectPosition",
      "@type": "owl:Class",
      "skos:editorialNote": {
        "@language": "en",
        "@value": "This is a class-like HY_Features term. Move it from the property inventory to the class inventory if it appears as a property."
      }
    },
    {
      "@id": "schema:PropertyValue",
      "skos:closeMatch": {
        "@id": "qudt:QuantityValue"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Use schema:PropertyValue for web markup and QUDT QuantityValue for formal numeric value/unit modeling. Avoid global equivalence because Schema.org PropertyValue is broader."
      }
    },
    {
      "@id": "hyf-app:HY_Catchment",
      "owl:equivalentClass": {
        "@id": "hyf:HY_Catchment"
      }
    },
    {
      "@id": "schema:url",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "rdfs:Resource"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Model URLs as IRI objects in RDF. If a source emits URL strings, normalize them to IRIs during RDF generation."
      }
    },
    {
      "@id": "qudt:hasQuantityKind",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "qudt:QuantityKind"
      }
    },
    {
      "@id": "schema:Place",
      "rdfs:subClassOf": {
        "@id": "geo:Feature"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Use schema:Place for web discovery and GeoSPARQL geo:Feature/geo:Geometry for formal spatial reasoning."
      }
    },
    {
      "@id": "schema:BreadcrumbList",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "schema:ItemList"
      }
    },
    {
      "@id": "schema:geo",
