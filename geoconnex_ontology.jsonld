    "sf": "http://www.opengis.net/ont/sf#",
    "sh": "http://www.w3.org/ns/shacl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sosa": "http://www.w3.org/ns/sosa/",
    "ssn": "http://www.w3.org/ns/ssn/",
    "ssn-system": "http://www.w3.org/ns/ssn/systems/",
    "time": "http://www.w3.org/2006/time#",
    "vann": "http://purl.org/vocab/vann/",
    "void": "http://rdfs.org/ns/void#",
    "wgs": "https://www.w3.org/2003/01/geo/wgs84_pos#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "schema:line",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "schema:GeoShape"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Prefer geo:asWKT for machine spatial reasoning; keep schema:line for Schema.org compatibility."
      }
    },
    {
      "@id": "http://schema.org/WebPage",
      "owl:equivalentClass": {
        "@id": "schema:WebPage"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Normalize to https://schema.org/WebPage in Geoconnex exports."
      }
    },
    {
      "@id": "schema:distribution",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "schema:Dataset"
      },
      "rdfs:range": {
        "@id": "schema:DataDownload"
      },
      "rdfs:subPropertyOf": {
        "@id": "dcat:distribution"
      }
    },
    {
      "@id": "sf:Polygon",
      "rdfs:subClassOf": {
        "@id": "geo:Geometry"
      }
    },
    {
      "@id": "qudt:hasUnit",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "qudt:Unit"
      }
    },
    {
      "@id": "hyf:HY_HydroLocation",
      "rdfs:subClassOf": {
        "@id": "geo:Feature"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Treat hydrolocations as geospatial features. Use GeoSPARQL geometry properties for precise location and HY_Features linear-reference properties for hydrologic network position."
      }
    },
    {
      "@id": "http://schema.org/WebSite",
      "owl:equivalentClass": {
        "@id": "schema:WebSite"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Normalize to https://schema.org/WebSite in Geoconnex exports."
      }
    },
    {
      "@id": "schema:SearchAction",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      }
    },
    {
      "@id": "hyf:HY_CatchmentDivide",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_CatchmentRealization"
      }
    },
    {
      "@id": "schema:Organization",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@id": "schema:unitCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:closeMatch": {
        "@id": "qudt:hasUnit"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "When possible, use qudt:hasUnit with a QUDT unit IRI. Keep schema:unitCode for UCUM or Schema.org-compatible literals."
      }
    },
    {
      "@id": "hyf:downstreamWaterBody",
      "@type": "owl:ObjectProperty",
      "owl:inverseOf": {
        "@id": "hyf:upstreamWaterBody"
      },
      "rdfs:subPropertyOf": {
        "@id": "nhdplusv2:downstreamWaterBodyTC"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Keep this as the immediate downstream relation. Use a separate transitive-closure property for reachability queries."
      }
    },
    {
      "@id": "hyf-app:HY_HydrometricNetwork",
      "skos:closeMatch": {
        "@id": "hyf:HY_HydrometricNetwork"
      }
    },
    {
      "@id": "owl:TransitiveProperty",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "owl:ObjectProperty"
      }
    },
    {
      "@id": "sf:LineString",
      "rdfs:subClassOf": {
        "@id": "geo:Geometry"
      }
    },
    {
      "@id": "hyf:HY_FlowPath",
      "rdfs:subClassOf": {
        "@id": "hyf:HY_CatchmentRealization"
      }
    },
    {
      "@id": "schema:variableMeasured",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "geoconnex:MeasuredVariable"
      }
    },
    {
      "@id": "schema:governmentAgency",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "schema:GovernmentOrganization"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "This is a property, not a class. Move it from the class inventory to the property inventory."
      }
    },
    {
      "@id": "schema:measurementTechnique",
      "@type": "owl:ObjectProperty",
      "rdfs:subPropertyOf": {
        "@id": "sosa:usedProcedure"
      }
    },
    {
      "@id": "schema:unitText",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Use schema:unitText only for human-readable unit labels. Add qudt:hasUnit when a controlled unit IRI is known."
      }
    },
    {
      "@id": "sf:MultiPolygon",
      "rdfs:subClassOf": {
        "@id": "geo:Geometry"
      }
    },
    {
      "@id": "schema:GeoShape",
      "skos:closeMatch": {
        "@id": "geo:Geometry"
      }
    },
    {
      "@id": "geoconnex:geoconnex-alignment",
      "@type": "owl:Ontology",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-06-02"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Recommended RDFS/OWL alignment axioms for an incomplete inventory of Geoconnex graph classes and properties. The ontology aligns hydrologic features with SawGraph/HY_Features, spatial descriptions with GeoSPARQL and Simple Features, web discovery metadata with Schema.org and DCAT, and observations/quantities with SOSA/SSN and QUDT."
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Geoconnex alignment recommendations"
      },
      "owl:imports": {
        "@id": "http://purl.org/spatialai/spatial/water-full"
      },
      "rdfs:seeAlso": [
        {
          "@id": "https://github.com/SAWGraph/water-kg/blob/main/ontologies/sawgraph-water-ontology.ttl"
        },
        {
          "@id": "schema:"
        },
        {
          "@id": "http://www.opengis.net/ont/geosparql"
        },
        {
          "@id": "dcat:"
        },
        {
          "@id": "sosa:"
        },
        {
          "@id": "qudt:"
        }
      ]
    },
    {
      "@id": "schema:provider",
      "@type": "owl:ObjectProperty",
      "rdfs:subPropertyOf": {
        "@id": "prov:wasAttributedTo"
      }
    },
    {
      "@id": "schema:WebPage",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@id": "http://schema.org/NewsArticle",
      "owl:equivalentClass": {
        "@id": "schema:NewsArticle"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Normalize to https://schema.org/NewsArticle in Geoconnex exports."
      }
    },
    {
      "@id": "rdf:Property",
      "@type": "owl:Class",
      "skos:editorialNote": {
        "@language": "en",
        "@value": "RDF's built-in class of properties. Do not use it as a catch-all declaration for Geoconnex predicates; classify predicates as owl:ObjectProperty, owl:DatatypeProperty, or owl:AnnotationProperty where possible."
      }
    },
    {
      "@id": "schema:logo",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "_:n3ca73efd176d4b82873374fc5ab256b9b1"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Model logos as resource links, preferably to a schema:ImageObject or image URL IRI."
      }
    },
    {
      "@id": "_:n3ca73efd176d4b82873374fc5ab256b9b1",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "schema:ImageObject"
          },
          {
            "@id": "rdfs:Resource"
          }
        ]
      }
    },
    {
      "@id": "geo:crs",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "geo:Geometry"
      }
    },
    {
      "@id": "hyf-app:HY_HydrographicNetwork",
      "skos:closeMatch": {
        "@id": "hyf:HY_HydrographicNetwork"
      }
    },
    {
      "@id": "schema:value",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "skos:closeMatch": {
        "@id": "qudt:numericValue"
      }
    },
    {
      "@id": "schema:encodingFormat",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:closeMatch": {
        "@id": "dcat:mediaType"
      },
      "skos:editorialNote": {
        "@language": "en",
        "@value": "Schema.org encodingFormat is commonly a text media type or URL. Keep it as a datatype property for Geoconnex exports; add dcat:mediaType separately when using controlled media-type resources."
      }
    },
    {
      "@id": "rdfs:Class",
      "@type": "owl:Class"
    },
    {
      "@id": "schema:GovernmentOrganization",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "schema:Organization"
      }
    },
